{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "App.jsx",
    "index.js",
    "src/**/*.js",
    "src/**/*.jsx",
    "__tests__/**/*.jsx"
  ],
  "exclude": ["node_modules", "android", "ios"]
}
